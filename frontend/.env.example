# Relative API path uses the Vite proxy locally and nginx in Docker.
VITE_API_BASE_URL=/api/v1
# Optional direct backend URL, e.g. https://api.example.com/api/v1
# VITE_WS_BASE_URL=wss://api.example.com/api/v1
# Vite's backend proxy target is a process environment variable.
# VITE_PROXY_TARGET=http://127.0.0.1:8000
